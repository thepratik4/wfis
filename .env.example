# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Elexon BMRS API Configuration
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
ELEXON_TIMEOUT_SECONDS="25"

# Day-Ahead Decision Cutoff Configuration
# Default assumption: 11:00 UTC on D-1 (1 day before the delivery settlement date),
# aligned with typical UK/GB day-ahead wholesale auction gate preparation (N2EX / EPEX SPOT 11:00 GMT).
DEFAULT_CUTOFF_TIME="11:00"
DEFAULT_CUTOFF_DAYS_BEFORE="1"

# Data Caching & Persistence Configuration
CACHE_DIR="/tmp/wind_forecast_cache"
CACHE_TTL_SECONDS="3600"
DEFAULT_DATA_MODE="live"

# Backend & CORS Configuration
BACKEND_PORT="8000"
BACKEND_URL="http://127.0.0.1:8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
VITE_API_BASE_URL="http://localhost:8000/api"
NEXT_PUBLIC_API_BASE_URL="/api"
